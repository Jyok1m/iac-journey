---
services:
  db:
    image: {{ ipseis_db_image }}
    container_name: {{ ipseis_db_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_db_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.5"
          memory: 2G
        reservations:
          memory: 512M
    command: --wiredTigerCacheSizeGB {{ ipseis_db_cache_gb }}
    volumes:
      - db_data:/data/db
      - db_config:/data/configdb
    # Credentials are read from the container's own environment: keeping them
    # out of the compose file keeps them out of `docker inspect` output.
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --username "$$MONGO_INITDB_ROOT_USERNAME"
          --password "$$MONGO_INITDB_ROOT_PASSWORD"
          --authenticationDatabase admin --eval "db.runCommand('ping').ok"
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      - "127.0.0.1:{{ ipseis_vault_db_external_port }}:27017/tcp"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # `private` is internal, so a published port would never be reachable
    # through it. `db-host` is the plain bridge that makes the loopback
    # binding above work — it is also the database's only route out.
    networks:
      - private
      - db-host

  api:
    image: {{ ipseis_api_image }}
    container_name: {{ ipseis_api_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_api_env_file }}
    environment:
      NODE_ENV: production
      NODE_OPTIONS: --max-old-space-size={{ ipseis_api_heap_mb }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_api_memory }}
        reservations:
          memory: 256M
    volumes:
      - "{{ ipseis_app_dir }}/uploads:/app/public/uploads"
    depends_on:
      db:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - private
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # Canonical host
      - traefik.http.routers.{{ ipseis_api_container_name }}.rule=Host(`{{ ipseis_api_host }}`)
      - traefik.http.routers.{{ ipseis_api_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ ipseis_api_container_name }}.loadbalancer.server.port=3000
      # Permanent redirect from the .com to the canonical .fr
      - traefik.http.routers.{{ ipseis_api_container_name }}-redirect.rule=Host(`{{ ipseis_api_redirect_host }}`)
      - traefik.http.routers.{{ ipseis_api_container_name }}-redirect.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_container_name }}-redirect.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_api_container_name }}-redirect.service={{ ipseis_api_container_name }}
      - traefik.http.routers.{{ ipseis_api_container_name }}-redirect.middlewares={{ ipseis_api_container_name }}-redirect
      - traefik.http.middlewares.{{ ipseis_api_container_name }}-redirect.redirectregex.regex=^https?://{{ ipseis_api_redirect_host | replace('.', '\\.') }}/(.*)
      - traefik.http.middlewares.{{ ipseis_api_container_name }}-redirect.redirectregex.replacement=https://{{ ipseis_api_host }}/$${1}
      - traefik.http.middlewares.{{ ipseis_api_container_name }}-redirect.redirectregex.permanent=true
{% if ipseis_dev_enabled %}

  db-dev:
    image: {{ ipseis_db_image }}
    container_name: {{ ipseis_db_dev_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_db_dev_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.5"
          memory: 2G
        reservations:
          memory: 512M
    command: --wiredTigerCacheSizeGB {{ ipseis_db_cache_gb }}
    volumes:
      - db_data_dev:/data/db
      - db_config_dev:/data/configdb
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --username "$$MONGO_INITDB_ROOT_USERNAME"
          --password "$$MONGO_INITDB_ROOT_PASSWORD"
          --authenticationDatabase admin --eval "db.runCommand('ping').ok"
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      - "127.0.0.1:{{ ipseis_vault_db_external_port_dev }}:27017/tcp"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - private-dev
      - db-host-dev

  api-dev:
    image: {{ ipseis_api_dev_image }}
    container_name: {{ ipseis_api_dev_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_api_dev_env_file }}
    environment:
      NODE_ENV: development
      NODE_OPTIONS: --max-old-space-size={{ ipseis_api_heap_mb }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_api_memory }}
        reservations:
          memory: 256M
    volumes:
      - "{{ ipseis_app_dir }}/uploads-dev:/app/public/uploads"
    depends_on:
      db-dev:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - private-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # Canonical host
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}.rule=Host(`{{ ipseis_api_dev_host }}`)
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ ipseis_api_dev_container_name }}.loadbalancer.server.port=3000
      # Permanent redirect from the .com to the canonical .fr
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-redirect.rule=Host(`{{ ipseis_api_dev_redirect_host }}`)
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-redirect.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-redirect.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-redirect.service={{ ipseis_api_dev_container_name }}
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-redirect.middlewares={{ ipseis_api_dev_container_name }}-redirect
      - traefik.http.middlewares.{{ ipseis_api_dev_container_name }}-redirect.redirectregex.regex=^https?://{{ ipseis_api_dev_redirect_host | replace('.', '\\.') }}/(.*)
      - traefik.http.middlewares.{{ ipseis_api_dev_container_name }}-redirect.redirectregex.replacement=https://{{ ipseis_api_dev_host }}/$${1}
      - traefik.http.middlewares.{{ ipseis_api_dev_container_name }}-redirect.redirectregex.permanent=true
{% endif %}

networks:
  private:
    name: {{ ipseis_app_name }}-internal
    internal: true
  db-host:
    name: {{ ipseis_app_name }}-db-host
  traefik-public:
    name: traefik-public
    external: true
{% if ipseis_dev_enabled %}
  private-dev:
    name: {{ ipseis_app_name }}-internal-dev
    internal: true
  db-host-dev:
    name: {{ ipseis_app_name }}-db-host-dev
{% endif %}

volumes:
  db_data:
    name: {{ ipseis_db_container_name }}
  db_config:
    name: {{ ipseis_db_container_name }}-configdb
{% if ipseis_dev_enabled %}
  db_data_dev:
    name: {{ ipseis_db_dev_container_name }}
  # Kept as -configdb-dev, not -dev-configdb: this is the name the existing
  # volume already has, and renaming it would silently start from an empty one.
  db_config_dev:
    name: {{ ipseis_db_container_name }}-configdb-dev
{% endif %}
