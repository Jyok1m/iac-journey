---
services:
  ipseis-db:
    image: {{ ipseis_db_image }}
    container_name: {{ ipseis_db_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_db_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.5"
          memory: 2G
        reservations:
          memory: 512M
    command: --wiredTigerCacheSizeGB {{ ipseis_db_cache_gb }}
    volumes:
      - ipseis-db:/data/db
      - ipseis-db-configdb:/data/configdb
    # Credentials are read from the container's own environment: keeping them
    # out of the compose file keeps them out of `docker inspect` output.
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --username "$$MONGO_INITDB_ROOT_USERNAME"
          --password "$$MONGO_INITDB_ROOT_PASSWORD"
          --authenticationDatabase admin --eval "db.runCommand('ping').ok"
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      - "127.0.0.1:{{ ipseis_vault_db_external_port }}:27017/tcp"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # ipseis-internal is internal, so a published port would never be reachable
    # through it. ipseis-db-host is the plain bridge that makes the loopback
    # binding above work — it is also the database's only route out.
    networks:
      - ipseis-internal
      - ipseis-db-host

  ipseis-api:
    image: {{ ipseis_api_image }}
    container_name: {{ ipseis_api_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_api_env_file }}
    environment:
      NODE_ENV: production
      NODE_OPTIONS: --max-old-space-size={{ ipseis_api_heap_mb }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_api_memory }}
        reservations:
          memory: 256M
    volumes:
      - "{{ ipseis_app_dir }}/uploads:/app/public/uploads"
    depends_on:
      ipseis-db:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # The API has no public host of its own. Its only route in is the
      # WebSocket below: the REST surface is reached by the front over
      # ipseis-internal, and express.static would otherwise serve
      # /uploads/*.pdf — contracts included — with no authentication at all.
      - traefik.http.services.{{ ipseis_api_container_name }}.loadbalancer.server.port=3000
      # Socket.io served under the front's own domain. The handshake
      # authenticates on the `token` cookie, which the front sets host-only on
      # its domain, and a Next route handler cannot relay a WebSocket — so this
      # router is the one thing that has to stay public. Priority beats the
      # front's router so the path prefix wins on the same host.
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.rule={{ ipseis_ws_router }}
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.priority=100
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.service={{ ipseis_api_container_name }}

  ipseis-web:
    image: {{ ipseis_web_image }}
    container_name: {{ ipseis_web_container_name }}
    restart: unless-stopped
    # NODE_ENV is pinned to production in the image and stays there on both
    # copies: the container runs a compiled standalone build either way, and
    # the front only marks its session cookie `secure` when it sees production.
    environment:
      NODE_OPTIONS: --max-old-space-size={{ ipseis_web_heap_mb }}
      # Server-side calls stay on the internal network: no round trip through
      # the public proxy, no TLS to negotiate, nothing that a DNS outage or an
      # expired certificate can break. Read at runtime, so the same image is
      # promoted from dev to prod without a rebuild.
      BACKEND_URL: http://{{ ipseis_api_container_name }}:3000
      # Browser-side WebSocket origin. Empty means same origin as the page,
      # which is exactly what the -ws router above serves.
      SOCKET_PUBLIC_URL: ""
      MAINTENANCE_MODE: "{{ ipseis_web_maintenance | ternary('true', 'false') }}"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_web_memory }}
        reservations:
          memory: 128M
    depends_on:
      - ipseis-api
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # ipseis-internal reaches the API; traefik-public carries both the inbound
    # traffic and the container's only route out, which next/image needs to
    # fetch the remote sources allowed in next.config.mjs.
    networks:
      - ipseis-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # Canonical host
      - traefik.http.routers.{{ ipseis_web_container_name }}.rule={{ ipseis_web_router }}
      - traefik.http.routers.{{ ipseis_web_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_web_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ ipseis_web_container_name }}.loadbalancer.server.port=3000
      # Permanent redirect from the aliases to the canonical host. One name has
      # to be the only one crawlers see, and NEXT_PUBLIC_SITE_URL — baked at
      # build time — already declares that name in the canonical tags.
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.rule={{ ipseis_web_alias_router }}
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.service={{ ipseis_web_container_name }}
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.middlewares={{ ipseis_web_container_name }}-alias
      - traefik.http.middlewares.{{ ipseis_web_container_name }}-alias.redirectregex.regex=^https?://[^/]+/(.*)
      - traefik.http.middlewares.{{ ipseis_web_container_name }}-alias.redirectregex.replacement=https://{{ ipseis_web_host }}/$${1}
      - traefik.http.middlewares.{{ ipseis_web_container_name }}-alias.redirectregex.permanent=true
{% if ipseis_dev_enabled %}

  ipseis-db-dev:
    image: {{ ipseis_db_image }}
    container_name: {{ ipseis_db_dev_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_db_dev_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.5"
          memory: 2G
        reservations:
          memory: 512M
    command: --wiredTigerCacheSizeGB {{ ipseis_db_cache_gb }}
    volumes:
      - ipseis-db-dev:/data/db
      - ipseis-db-configdb-dev:/data/configdb
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --username "$$MONGO_INITDB_ROOT_USERNAME"
          --password "$$MONGO_INITDB_ROOT_PASSWORD"
          --authenticationDatabase admin --eval "db.runCommand('ping').ok"
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      - "127.0.0.1:{{ ipseis_vault_db_external_port_dev }}:27017/tcp"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal-dev
      - ipseis-db-host-dev

  ipseis-api-dev:
    image: {{ ipseis_api_dev_image }}
    container_name: {{ ipseis_api_dev_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_api_dev_env_file }}
    environment:
      NODE_ENV: development
      NODE_OPTIONS: --max-old-space-size={{ ipseis_api_heap_mb }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_api_memory }}
        reservations:
          memory: 256M
    volumes:
      - "{{ ipseis_app_dir }}/uploads-dev:/app/public/uploads"
    depends_on:
      ipseis-db-dev:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # No public host either, same reasoning as prod.
      - traefik.http.services.{{ ipseis_api_dev_container_name }}.loadbalancer.server.port=3000
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.rule={{ ipseis_ws_dev_router }}
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.priority=100
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.service={{ ipseis_api_dev_container_name }}

  ipseis-web-dev:
    image: {{ ipseis_web_dev_image }}
    container_name: {{ ipseis_web_dev_container_name }}
    restart: unless-stopped
    environment:
      NODE_OPTIONS: --max-old-space-size={{ ipseis_web_heap_mb }}
      BACKEND_URL: http://{{ ipseis_api_dev_container_name }}:3000
      SOCKET_PUBLIC_URL: ""
      MAINTENANCE_MODE: "{{ ipseis_web_dev_maintenance | ternary('true', 'false') }}"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_web_memory }}
        reservations:
          memory: 128M
    depends_on:
      - ipseis-api-dev
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # No alias router here: the dev front answers on a single name, and
      # nothing should be indexing it anyway.
      - traefik.http.routers.{{ ipseis_web_dev_container_name }}.rule={{ ipseis_web_dev_router }}
      - traefik.http.routers.{{ ipseis_web_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_web_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ ipseis_web_dev_container_name }}.loadbalancer.server.port=3000
{% endif %}

# Compose stamps every network and volume it creates with the key used to
# declare it, then refuses to touch one whose stamp no longer matches. These
# keys are therefore frozen on the names the running stack was built with —
# shortening them to `private` or `db_data` would strand the live networks and
# start the databases from empty volumes.
networks:
  ipseis-internal:
    name: {{ ipseis_app_name }}-internal
    internal: true
  ipseis-db-host:
    name: {{ ipseis_app_name }}-db-host
  traefik-public:
    name: traefik-public
    external: true
{% if ipseis_dev_enabled %}
  ipseis-internal-dev:
    name: {{ ipseis_app_name }}-internal-dev
    internal: true
  ipseis-db-host-dev:
    name: {{ ipseis_app_name }}-db-host-dev
{% endif %}

volumes:
  ipseis-db:
    name: {{ ipseis_db_container_name }}
  ipseis-db-configdb:
    name: {{ ipseis_db_container_name }}-configdb
{% if ipseis_dev_enabled %}
  ipseis-db-dev:
    name: {{ ipseis_db_dev_container_name }}
  ipseis-db-configdb-dev:
    name: {{ ipseis_db_container_name }}-configdb-dev
{% endif %}
