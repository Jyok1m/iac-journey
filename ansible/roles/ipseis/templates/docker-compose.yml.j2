---
services:
  ipseis-db:
    image: {{ ipseis_db_image }}
    container_name: {{ ipseis_db_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_db_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.5"
          memory: 2G
        reservations:
          memory: 512M
    command: --wiredTigerCacheSizeGB {{ ipseis_db_cache_gb }}
    volumes:
      - ipseis-db:/data/db
      - ipseis-db-configdb:/data/configdb
    # From the container's own environment, so they stay out of
    # `docker inspect`.
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --username "$$MONGO_INITDB_ROOT_USERNAME"
          --password "$$MONGO_INITDB_ROOT_PASSWORD"
          --authenticationDatabase admin --eval "db.runCommand('ping').ok"
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      - "127.0.0.1:{{ ipseis_vault_db_external_port }}:27017/tcp"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # ipseis-internal is internal, so the published port needs the plain
    # bridge to be reachable at all.
    networks:
      - ipseis-internal
      - ipseis-db-host

  ipseis-api:
    image: {{ ipseis_api_image }}
    container_name: {{ ipseis_api_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_api_env_file }}
    environment:
      NODE_ENV: production
      NODE_OPTIONS: --max-old-space-size={{ ipseis_api_heap_mb }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_api_memory }}
        reservations:
          memory: 256M
    volumes:
      - "{{ ipseis_app_dir }}/uploads:/app/public/uploads"
    depends_on:
      ipseis-db:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # No public host: the front reaches REST over ipseis-internal, and
      # express.static would otherwise serve /uploads/*.pdf unauthenticated.
      - traefik.http.services.{{ ipseis_api_container_name }}.loadbalancer.server.port=3000
      # Socket.io under the front's own domain: the handshake reads the
      # host-only `token` cookie, and a Next route handler cannot relay a
      # WebSocket. Priority beats the front's router on the same host.
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.rule={{ ipseis_ws_router }}
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.priority=100
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_api_container_name }}-ws.service={{ ipseis_api_container_name }}

  ipseis-web:
    image: {{ ipseis_web_image }}
    container_name: {{ ipseis_web_container_name }}
    restart: unless-stopped
    # production on both copies: the front only marks its session cookie
    # `secure` when it sees it.
    environment:
      NODE_OPTIONS: --max-old-space-size={{ ipseis_web_heap_mb }}
      # Internal network: no round trip through the public proxy. Read at
      # runtime, so the same image is promoted from dev to prod as is.
      BACKEND_URL: http://{{ ipseis_api_container_name }}:3000
      # Empty means same origin as the page, which the -ws router serves.
      SOCKET_PUBLIC_URL: ""
      MAINTENANCE_MODE: "{{ ipseis_web_maintenance | ternary('true', 'false') }}"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_web_memory }}
        reservations:
          memory: 128M
    depends_on:
      - ipseis-api
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # traefik-public carries the inbound traffic and is also the only route
    # out, which next/image needs for the remote sources.
    networks:
      - ipseis-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ ipseis_web_container_name }}.rule={{ ipseis_web_router }}
      - traefik.http.routers.{{ ipseis_web_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_web_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ ipseis_web_container_name }}.loadbalancer.server.port=3000
      # The aliases redirect to the canonical host, the one
      # NEXT_PUBLIC_SITE_URL already declares in the canonical tags.
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.rule={{ ipseis_web_alias_router }}
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.service={{ ipseis_web_container_name }}
      - traefik.http.routers.{{ ipseis_web_container_name }}-alias.middlewares={{ ipseis_web_container_name }}-alias
      - traefik.http.middlewares.{{ ipseis_web_container_name }}-alias.redirectregex.regex=^https?://[^/]+/(.*)
      - traefik.http.middlewares.{{ ipseis_web_container_name }}-alias.redirectregex.replacement=https://{{ ipseis_web_host }}/$${1}
      - traefik.http.middlewares.{{ ipseis_web_container_name }}-alias.redirectregex.permanent=true
{% if ipseis_dev_enabled %}

  ipseis-db-dev:
    image: {{ ipseis_db_image }}
    container_name: {{ ipseis_db_dev_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_db_dev_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.5"
          memory: 2G
        reservations:
          memory: 512M
    command: --wiredTigerCacheSizeGB {{ ipseis_db_cache_gb }}
    volumes:
      - ipseis-db-dev:/data/db
      - ipseis-db-configdb-dev:/data/configdb
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet --username "$$MONGO_INITDB_ROOT_USERNAME"
          --password "$$MONGO_INITDB_ROOT_PASSWORD"
          --authenticationDatabase admin --eval "db.runCommand('ping').ok"
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      - "127.0.0.1:{{ ipseis_vault_db_external_port_dev }}:27017/tcp"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal-dev
      - ipseis-db-host-dev

  ipseis-api-dev:
    image: {{ ipseis_api_dev_image }}
    container_name: {{ ipseis_api_dev_container_name }}
    restart: unless-stopped
    env_file: {{ ipseis_api_dev_env_file }}
    environment:
      NODE_ENV: development
      NODE_OPTIONS: --max-old-space-size={{ ipseis_api_heap_mb }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_api_memory }}
        reservations:
          memory: 256M
    volumes:
      - "{{ ipseis_app_dir }}/uploads-dev:/app/public/uploads"
    depends_on:
      ipseis-db-dev:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # No public host either, same reasoning as prod.
      - traefik.http.services.{{ ipseis_api_dev_container_name }}.loadbalancer.server.port=3000
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.rule={{ ipseis_ws_dev_router }}
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.priority=100
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ ipseis_api_dev_container_name }}-ws.service={{ ipseis_api_dev_container_name }}

  ipseis-web-dev:
    image: {{ ipseis_web_dev_image }}
    container_name: {{ ipseis_web_dev_container_name }}
    restart: unless-stopped
    environment:
      NODE_OPTIONS: --max-old-space-size={{ ipseis_web_heap_mb }}
      BACKEND_URL: http://{{ ipseis_api_dev_container_name }}:3000
      SOCKET_PUBLIC_URL: ""
      MAINTENANCE_MODE: "{{ ipseis_web_dev_maintenance | ternary('true', 'false') }}"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ ipseis_web_memory }}
        reservations:
          memory: 128M
    depends_on:
      - ipseis-api-dev
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - ipseis-internal-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ ipseis_web_dev_container_name }}.rule={{ ipseis_web_dev_router }}
      - traefik.http.routers.{{ ipseis_web_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ ipseis_web_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ ipseis_web_dev_container_name }}.loadbalancer.server.port=3000
{% endif %}

# Compose stamps each network and volume with the key used to declare it and
# refuses to touch one whose stamp moved. These keys are frozen on what the
# running stack was built with: renaming one strands it.
networks:
  ipseis-internal:
    name: {{ ipseis_app_name }}-internal
    internal: true
  ipseis-db-host:
    name: {{ ipseis_app_name }}-db-host
  traefik-public:
    name: traefik-public
    external: true
{% if ipseis_dev_enabled %}
  ipseis-internal-dev:
    name: {{ ipseis_app_name }}-internal-dev
    internal: true
  ipseis-db-host-dev:
    name: {{ ipseis_app_name }}-db-host-dev
{% endif %}

volumes:
  ipseis-db:
    name: {{ ipseis_db_container_name }}
  ipseis-db-configdb:
    name: {{ ipseis_db_container_name }}-configdb
{% if ipseis_dev_enabled %}
  ipseis-db-dev:
    name: {{ ipseis_db_dev_container_name }}
  ipseis-db-configdb-dev:
    name: {{ ipseis_db_container_name }}-configdb-dev
{% endif %}
