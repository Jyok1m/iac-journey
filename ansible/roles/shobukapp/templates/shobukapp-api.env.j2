# {{ ansible_managed }}

PORT={{ shobukapp_api_port }}

# The deployment, not how Node was built: both copies run NODE_ENV=production.
# The API refuses a live Stripe key outside production.
APP_ENV={{ app_env }}
WEB_URL={{ web_url }}

# By container name over this copy's internal network, never through the
# loopback port published on the host. Urlencoded: a generated password may
# carry characters that end the userinfo part of a URL.
DATABASE_URL=postgresql://{{ shobukapp_pg_user }}:{{ pg_password | urlencode | replace('/', '%2F') }}@{{ pg_host }}:{{ shobukapp_pg_port }}/{{ shobukapp_pg_db }}?schema=public

SESSION_TTL_DAYS={{ shobukapp_session_ttl_days }}
STORAGE_DIR={{ shobukapp_storage_dir }}

# One pair per Stripe mode, the admin dashboard picks the serving one. A mode
# without key is simply unavailable. In production a key without its webhook
# secret makes the API refuse to boot. One endpoint per mode to declare in the
# dashboard, same URL: {{ web_url }}{{ shobukapp_webhook_path }}.
STRIPE_TEST_SECRET_KEY={{ stripe_test_secret_key }}
STRIPE_TEST_WEBHOOK_SECRET={{ stripe_test_webhook_secret }}
STRIPE_LIVE_SECRET_KEY={{ stripe_live_secret_key }}
STRIPE_LIVE_WEBHOOK_SECRET={{ stripe_live_webhook_secret }}

SMTP_HOST={{ shobukapp_smtp_host }}
SMTP_PORT={{ shobukapp_smtp_port }}
SMTP_USER={{ shobukapp_smtp_user }}
SMTP_PASSWORD={{ mailcow_vault_mailboxes[shobukapp_smtp_user] | default('', true) }}
# Single quotes: the value carries spaces and angle brackets.
MAIL_FROM='{{ mail_from }}'
