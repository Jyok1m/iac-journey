# {{ ansible_managed }}
#
# In a file, not on the command line: an argument stays visible in
# `docker inspect` and in the host's process table.
requirepass {{ redis_password }}

# Sessions must survive a restart. everysec risks one second of writes.
appendonly yes
appendfsync everysec

# Every key carries a TTL, so hitting the ceiling drops the oldest sessions
# instead of failing new logins.
maxmemory {{ odyssai_redis_maxmemory }}
maxmemory-policy volatile-ttl

# Second lock behind the internal network, in case of a misrouted publish.
protected-mode yes

# The API only ever reads and writes keys.
rename-command CONFIG ""
rename-command FLUSHALL ""
rename-command FLUSHDB ""
