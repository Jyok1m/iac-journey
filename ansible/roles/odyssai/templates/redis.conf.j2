# {{ ansible_managed }}
#
# In a file, not on the command line: an argument stays visible in
# `docker inspect` and in the host's process table.
requirepass {{ redis_password }}

# Sessions must survive a restart. everysec risks one second of writes.
appendonly yes
appendfsync everysec

# noeviction, not volatile-ttl. Nothing here is a recomputable cache: sessions
# are the only record of who is signed in, the guide budget counter guards real
# spend, and the generation queue carries a player's world. Evicting by TTL
# would drop exactly those, silently, while BullMQ keys, which carry no TTL,
# survived. A loud write failure at the ceiling is the lesser harm, and it is
# alertable. BullMQ refuses to work correctly under any other policy.
maxmemory {{ odyssai_redis_maxmemory }}
maxmemory-policy noeviction

# Second lock behind the internal network, in case of a misrouted publish.
protected-mode yes

# The API only ever reads and writes keys.
rename-command CONFIG ""
rename-command FLUSHALL ""
rename-command FLUSHDB ""
