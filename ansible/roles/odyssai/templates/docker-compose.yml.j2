---
services:
  redis:
    image: {{ odyssai_redis_image }}
    container_name: {{ odyssai_redis_container_name }}
    restart: unless-stopped
    command:
      - redis-server
      - /usr/local/etc/redis/redis.conf
    volumes:
      - ./{{ odyssai_redis_conf_file }}:/usr/local/etc/redis/redis.conf:ro
      - redis-data:/data
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: {{ odyssai_redis_memory }}
        reservations:
          memory: 32M
    # Unauthenticated: NOAUTH proves the server is up, and passing the password
    # would leak it into `docker inspect`.
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli ping 2>&1 | grep -qE 'PONG|NOAUTH'
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal

  db:
    image: {{ odyssai_pg_image }}
    container_name: {{ odyssai_pg_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_pg_env_file }}
    command:
      - postgres
      - -c
      - shared_buffers={{ odyssai_pg_shared_buffers }}
      - -c
      - effective_cache_size={{ odyssai_pg_effective_cache_size }}
      - -c
      - max_connections={{ odyssai_pg_max_connections }}
    volumes:
      # Not .../data: since 18 PGDATA sits one level down, and this is the
      # path the image's own VOLUME declares.
      - db-data:/var/lib/postgresql
    # Loopback only: 5432 is never opened in ufw, so reaching it from off the
    # host means an SSH tunnel.
    ports:
      - "127.0.0.1:{{ odyssai_pg_port_host }}:{{ odyssai_pg_port }}/tcp"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_pg_memory }}
        reservations:
          memory: 256M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    # STOPSIGNAL is SIGINT: a fast shutdown still has to checkpoint, and the
    # default 10s grace would SIGKILL it into a crash recovery.
    stop_grace_period: 1m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # odyssai-internal is internal, so the published port needs the plain
    # bridge to be reachable at all.
    networks:
      - odyssai-internal
      - odyssai-db-host

  # Applies the pending migrations and exits. The API image ships without the
  # Prisma CLI on purpose, so nothing else can, and the `tools` profile keeps
  # this one out of every `up`.
  migrate:
    image: {{ odyssai_migrate_image }}
    # No container_name: `compose run` names its own, and a fixed one would
    # collide with a run still on the host.
    profiles:
      - tools
    restart: "no"
    env_file: {{ odyssai_api_env_file }}
    # Starts the database and waits for it, so this holds on a host where
    # nothing runs yet.
    depends_on:
      db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: {{ odyssai_migrate_memory }}
    networks:
      - odyssai-internal

  api:
    image: {{ odyssai_api_image }}
    container_name: {{ odyssai_api_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_api_env_file }}
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_api_port }}"
      NODE_OPTIONS: --max-old-space-size={{ odyssai_api_heap_mb }}
    # Health gate, unlike the front's: the API opens both connections at boot,
    # so starting it early is just a crash loop.
    depends_on:
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_api_memory }}
        reservations:
          memory: 128M
    # node's own fetch: curl and wget are not guaranteed in the slim base.
    # /health/ready and not /: the latter answers without consulting anything,
    # so a container whose database was unreachable called itself healthy and
    # Traefik kept routing players to it. The probe pings Redis and Postgres
    # and answers 503 when either is missing.
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_api_port }}/health/ready').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # traefik-public carries the inbound traffic and is also the only route
    # out, which Keycloak's token endpoint already needs.
    networks:
      - odyssai-internal
      - traefik-public
    labels:
{% if odyssai_api_public %}
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ odyssai_api_container_name }}.rule={{ odyssai_api_router }}
      - traefik.http.routers.{{ odyssai_api_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_api_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_api_container_name }}.loadbalancer.server.port={{ odyssai_api_port }}
{% else %}
      - traefik.enable=false
{% endif %}

  worker:
    image: {{ odyssai_worker_image }}
    container_name: {{ odyssai_worker_container_name }}
    restart: unless-stopped
    # The API's own file: the worker reads the same Postgres, Redis, LangSmith
    # and provider values, and a second copy would drift from it.
    env_file: {{ odyssai_api_env_file }}
    environment:
      NODE_ENV: production
      NODE_OPTIONS: --max-old-space-size={{ odyssai_worker_heap_mb }}
    # Same health gate as the API: it opens both connections at boot, so
    # starting it early is just a crash loop.
    depends_on:
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_worker_memory }}
        reservations:
          memory: 128M
    # No healthcheck: it listens on nothing, so there is nothing to probe. A
    # crash is caught by restart, and a job left in flight is picked up again.
    #
    # SIGTERM lets the world in progress finish. Past this grace the job's Redis
    # lock expires and the next run resumes at the node after the last
    # checkpoint, so a hard kill costs one node, not one world.
    stop_grace_period: 2m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # traefik-public carries nothing inbound here: it is the only way out.
    # odyssai-internal is internal, and the worker calls the model provider.
    networks:
      - odyssai-internal
      - traefik-public
    labels:
      - traefik.enable=false

  web:
    image: {{ odyssai_web_image }}
    container_name: {{ odyssai_web_container_name }}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_web_port }}"
      HOSTNAME: 0.0.0.0
      NODE_OPTIONS: --max-old-space-size={{ odyssai_web_heap_mb }}
      # Baked into the image for the prerendered locales; repeated for the
      # routes that read it at request time.
      SITE_URL: {{ odyssai_site_url }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_web_memory }}
        reservations:
          memory: 128M
    # Ordering only, no health gate: an unhealthy API must not hold the public
    # site down: that is a per-request failure, not a boot one.
    depends_on:
      - api
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_web_port }}/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # Server-side calls to the API stay on odyssai-internal, no round trip
    # through the public proxy.
    networks:
      - odyssai-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ odyssai_web_container_name }}.rule={{ odyssai_web_router }}
      - traefik.http.routers.{{ odyssai_web_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_web_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_web_container_name }}.loadbalancer.server.port={{ odyssai_web_port }}
      # www redirects to the canonical host, the one SITE_URL already declares
      # in the canonical tags.
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.rule={{ odyssai_web_alias_router }}
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.service={{ odyssai_web_container_name }}
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.middlewares={{ odyssai_web_container_name }}-alias
      - traefik.http.middlewares.{{ odyssai_web_container_name }}-alias.redirectregex.regex=^https?://[^/]+/(.*)
      - traefik.http.middlewares.{{ odyssai_web_container_name }}-alias.redirectregex.replacement=https://{{ odyssai_web_host }}/$${1}
      - traefik.http.middlewares.{{ odyssai_web_container_name }}-alias.redirectregex.permanent=true
{% if odyssai_dev_enabled | bool %}

  redis-dev:
    image: {{ odyssai_redis_image }}
    container_name: {{ odyssai_redis_dev_container_name }}
    restart: unless-stopped
    command:
      - redis-server
      - /usr/local/etc/redis/redis.conf
    volumes:
      - ./{{ odyssai_redis_dev_conf_file }}:/usr/local/etc/redis/redis.conf:ro
      - redis-dev-data:/data
    ports:
      - "127.0.0.1:{{ odyssai_redis_port_dev }}:{{ odyssai_redis_port }}"
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: {{ odyssai_redis_memory }}
        reservations:
          memory: 32M
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli ping 2>&1 | grep -qE 'PONG|NOAUTH'
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal-dev

  db-dev:
    image: {{ odyssai_pg_image }}
    container_name: {{ odyssai_pg_dev_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_pg_dev_env_file }}
    command:
      - postgres
      - -c
      - shared_buffers={{ odyssai_pg_shared_buffers }}
      - -c
      - effective_cache_size={{ odyssai_pg_effective_cache_size }}
      - -c
      - max_connections={{ odyssai_pg_max_connections }}
    volumes:
      - db-dev-data:/var/lib/postgresql
    ports:
      - "127.0.0.1:{{ odyssai_pg_port_host_dev }}:{{ odyssai_pg_port }}/tcp"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_pg_memory }}
        reservations:
          memory: 256M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    stop_grace_period: 1m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # No companion bridge: odyssai-internal-dev is already a plain one.
    networks:
      - odyssai-internal-dev

  migrate-dev:
    image: {{ odyssai_migrate_dev_image }}
    profiles:
      - tools
    restart: "no"
    env_file: {{ odyssai_api_dev_env_file }}
    depends_on:
      db-dev:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: {{ odyssai_migrate_memory }}
    networks:
      - odyssai-internal-dev

  api-dev:
    image: {{ odyssai_api_dev_image }}
    container_name: {{ odyssai_api_dev_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_api_dev_env_file }}
    # production here too: same compiled build either way, and development
    # would only diverge from what production actually runs.
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_api_port }}"
      NODE_OPTIONS: --max-old-space-size={{ odyssai_api_heap_mb }}
    depends_on:
      redis-dev:
        condition: service_healthy
      db-dev:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_api_memory }}
        reservations:
          memory: 128M
    # /health/ready and not /: the latter answers without consulting anything,
    # so a container whose database was unreachable called itself healthy and
    # Traefik kept routing players to it. The probe pings Redis and Postgres
    # and answers 503 when either is missing.
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_api_port }}/health/ready').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal-dev
      - traefik-public
    labels:
{% if odyssai_api_public %}
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ odyssai_api_dev_container_name }}.rule={{ odyssai_api_dev_router }}
      - traefik.http.routers.{{ odyssai_api_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_api_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_api_dev_container_name }}.loadbalancer.server.port={{ odyssai_api_port }}
{% else %}
      - traefik.enable=false
{% endif %}

  worker-dev:
    image: {{ odyssai_worker_dev_image }}
    container_name: {{ odyssai_worker_dev_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_api_dev_env_file }}
    environment:
      NODE_ENV: production
      NODE_OPTIONS: --max-old-space-size={{ odyssai_worker_heap_mb }}
    depends_on:
      redis-dev:
        condition: service_healthy
      db-dev:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_worker_memory }}
        reservations:
          memory: 128M
    stop_grace_period: 2m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # No traefik-public, unlike its production twin: odyssai-internal-dev is a
    # plain bridge, so it already routes out. Joining the shared network for
    # nothing would only widen what this container sits next to.
    networks:
      - odyssai-internal-dev
    labels:
      - traefik.enable=false

  web-dev:
    image: {{ odyssai_web_dev_image }}
    container_name: {{ odyssai_web_dev_container_name }}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_web_port }}"
      HOSTNAME: 0.0.0.0
      NODE_OPTIONS: --max-old-space-size={{ odyssai_web_heap_mb }}
      SITE_URL: {{ odyssai_dev_site_url }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_web_memory }}
        reservations:
          memory: 128M
    depends_on:
      - api-dev
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_web_port }}/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.rule={{ odyssai_web_dev_router }}
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_web_dev_container_name }}.loadbalancer.server.port={{ odyssai_web_port }}
{% if odyssai_dev_basic_auth | bool %}
      # usersfile and not users: the hash stays in a file mounted into traefik,
      # out of the labels that docker inspect exposes to the deploy group.
      # api-dev is deliberately left open, a 401 on a cross-origin fetch carries
      # no CORS headers and the front would break rather than prompt.
      - traefik.http.middlewares.{{ odyssai_web_dev_container_name }}-auth.basicauth.usersfile={{ odyssai_dev_basic_auth_file }}
      - traefik.http.middlewares.{{ odyssai_web_dev_container_name }}-auth.basicauth.realm={{ odyssai_dev_basic_auth_realm }}
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.middlewares={{ odyssai_web_dev_container_name }}-auth
{% endif %}
{% endif %}

volumes:
  redis-data:
    name: {{ odyssai_app_name }}-redis-data
  db-data:
    name: {{ odyssai_app_name }}-db-data
{% if odyssai_dev_enabled | bool %}
  redis-dev-data:
    name: {{ odyssai_app_name }}-redis-dev-data
  db-dev-data:
    name: {{ odyssai_app_name }}-db-dev-data
{% endif %}

# Compose stamps each network with the key used to declare it and refuses to
# touch one whose stamp moved: renaming a key strands the running network.
networks:
  odyssai-internal:
    name: {{ odyssai_app_name }}-internal
    internal: true
  # Only so the production database can publish a port on the host.
  odyssai-db-host:
    name: {{ odyssai_app_name }}-db-host
  traefik-public:
    name: traefik-public
    external: true
{% if odyssai_dev_enabled | bool %}
  odyssai-internal-dev:
    name: {{ odyssai_app_name }}-internal-dev
{% endif %}
