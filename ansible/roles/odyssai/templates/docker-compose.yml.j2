---
services:
  # Session store for the API. Never on traefik-public: odyssai-internal is
  # declared internal, so there is no route from the outside to this port at
  # all, and the password is a second lock rather than the only one.
  redis:
    image: {{ odyssai_redis_image }}
    container_name: {{ odyssai_redis_container_name }}
    restart: unless-stopped
    command:
      - redis-server
      - /usr/local/etc/redis/redis.conf
    volumes:
      - ./{{ odyssai_redis_conf_file }}:/usr/local/etc/redis/redis.conf:ro
      - redis-data:/data
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: {{ odyssai_redis_memory }}
        reservations:
          memory: 32M
    # Unauthenticated on purpose: a bare PING answers NOAUTH when the server is
    # up, which is all a liveness probe needs to know. Passing the password
    # would leave it in `docker inspect`, which is exactly what the config file
    # avoids.
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli ping 2>&1 | grep -qE 'PONG|NOAUTH'
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal

  # Application database. Same split as the session store — one server per copy
  # of the stack — with one difference: this one is published on the host
  # loopback. Schema work, dumps and one-off queries are run from a workstation
  # over an SSH tunnel, and there is no admin UI behind Traefik to do it with.
  db:
    image: {{ odyssai_pg_image }}
    container_name: {{ odyssai_pg_container_name }}
    restart: unless-stopped
    # POSTGRES_* live here rather than in `environment`: an inline value would
    # be readable in `docker inspect` by anyone in the deploy group.
    env_file: {{ odyssai_pg_env_file }}
    command:
      - postgres
      - -c
      - shared_buffers={{ odyssai_pg_shared_buffers }}
      - -c
      - effective_cache_size={{ odyssai_pg_effective_cache_size }}
      - -c
      - max_connections={{ odyssai_pg_max_connections }}
    volumes:
      # The whole /var/lib/postgresql, not .../data: since 18 the image keeps
      # PGDATA one level down, in a version-named directory, and that is the
      # path its own VOLUME declares.
      - db-data:/var/lib/postgresql
    # Loopback only. 5432 is never opened in ufw and the interface is not
    # routable, so reaching it from outside the host means an SSH tunnel.
    ports:
      - "127.0.0.1:{{ odyssai_pg_port_host }}:{{ odyssai_pg_port }}/tcp"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_pg_memory }}
        reservations:
          memory: 256M
    # Credentials read back out of the container's own environment rather than
    # repeated here, for the same reason env_file exists above.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    # The image's STOPSIGNAL is SIGINT — a fast shutdown, which still has to
    # flush its buffers and write a checkpoint. The default 10s grace would cut
    # that short with a SIGKILL and turn every redeploy into a crash recovery.
    stop_grace_period: 1m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # odyssai-internal is declared internal, so a port published through it
    # alone would never be reachable: the bridge has no route to the host.
    # odyssai-db-host is the plain bridge that makes the loopback binding above
    # work, and it is also this container's only way out.
    networks:
      - odyssai-internal
      - odyssai-db-host

  api:
    image: {{ odyssai_api_image }}
    container_name: {{ odyssai_api_container_name }}
    restart: unless-stopped
    # Origins, realm and secrets. Rendered by the role, 0600, outside this
    # file: the compose file is readable by the deploy group, these are not.
    env_file: {{ odyssai_api_env_file }}
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_api_port }}"
      NODE_OPTIONS: --max-old-space-size={{ odyssai_api_heap_mb }}
    # Health gate, unlike the front's: the API validates its config and opens
    # its Redis and Postgres connections at boot, so starting it before the two
    # stores are up would only produce a crash loop.
    depends_on:
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_api_memory }}
        reservations:
          memory: 128M
    # node's own fetch rather than curl or wget: neither is guaranteed to stay
    # in the slim base, and the runtime stage installs nothing. Anything under
    # 500 counts as alive — a redirect still proves the server is answering.
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_api_port }}/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # odyssai-internal is where the front reaches it and where it reaches Redis;
    # traefik-public carries the inbound traffic and is also the container's
    # only route out, which the LLM calls will need as soon as packages/llm is
    # wired in — and which Keycloak already needs for the token endpoint.
    networks:
      - odyssai-internal
      - traefik-public
    labels:
{% if odyssai_api_public %}
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ odyssai_api_container_name }}.rule={{ odyssai_api_router }}
      - traefik.http.routers.{{ odyssai_api_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_api_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_api_container_name }}.loadbalancer.server.port={{ odyssai_api_port }}
{% else %}
      # No public router: the API answers on odyssai-internal only.
      - traefik.enable=false
{% endif %}

  web:
    image: {{ odyssai_web_image }}
    container_name: {{ odyssai_web_container_name }}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_web_port }}"
      HOSTNAME: 0.0.0.0
      NODE_OPTIONS: --max-old-space-size={{ odyssai_web_heap_mb }}
      # Already baked into the image by the pipeline for the prerendered
      # locales; repeated here for the routes that read it at request time.
      SITE_URL: {{ odyssai_site_url }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_web_memory }}
        reservations:
          memory: 128M
    # Start ordering only, no health gate: the public site must not be held
    # down by an unhealthy API — the front renders on its own today, and even
    # once it calls the API that is a per-request failure, not a boot one.
    depends_on:
      - api
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_web_port }}/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # Server-side calls to the API stay on odyssai-internal once the front
    # starts making them: http://{{ odyssai_api_container_name }}:{{ odyssai_api_port }},
    # no round trip through the public proxy, nothing a DNS outage or an expired
    # certificate can break.
    networks:
      - odyssai-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # Canonical host
      - traefik.http.routers.{{ odyssai_web_container_name }}.rule={{ odyssai_web_router }}
      - traefik.http.routers.{{ odyssai_web_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_web_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_web_container_name }}.loadbalancer.server.port={{ odyssai_web_port }}
      # Permanent redirect from www to the canonical host. One name has to be
      # the only one crawlers see, and SITE_URL — baked at build time — already
      # declares that name in the canonical tags.
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.rule={{ odyssai_web_alias_router }}
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.service={{ odyssai_web_container_name }}
      - traefik.http.routers.{{ odyssai_web_container_name }}-alias.middlewares={{ odyssai_web_container_name }}-alias
      - traefik.http.middlewares.{{ odyssai_web_container_name }}-alias.redirectregex.regex=^https?://[^/]+/(.*)
      - traefik.http.middlewares.{{ odyssai_web_container_name }}-alias.redirectregex.replacement=https://{{ odyssai_web_host }}/$${1}
      - traefik.http.middlewares.{{ odyssai_web_container_name }}-alias.redirectregex.permanent=true
{% if odyssai_dev_enabled | bool %}

  # Its own store, its own password, its own network: a session opened on the
  # dev copy must never be readable from production, nor the other way round.
  redis-dev:
    image: {{ odyssai_redis_image }}
    container_name: {{ odyssai_redis_dev_container_name }}
    restart: unless-stopped
    command:
      - redis-server
      - /usr/local/etc/redis/redis.conf
    volumes:
      - ./{{ odyssai_redis_dev_conf_file }}:/usr/local/etc/redis/redis.conf:ro
      - redis-dev-data:/data
    ports:
      - "127.0.0.1:{{ odyssai_redis_port_dev }}:{{ odyssai_redis_port }}"
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: {{ odyssai_redis_memory }}
        reservations:
          memory: 32M
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli ping 2>&1 | grep -qE 'PONG|NOAUTH'
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal-dev

  db-dev:
    image: {{ odyssai_pg_image }}
    container_name: {{ odyssai_pg_dev_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_pg_dev_env_file }}
    command:
      - postgres
      - -c
      - shared_buffers={{ odyssai_pg_shared_buffers }}
      - -c
      - effective_cache_size={{ odyssai_pg_effective_cache_size }}
      - -c
      - max_connections={{ odyssai_pg_max_connections }}
    volumes:
      - db-dev-data:/var/lib/postgresql
    ports:
      - "127.0.0.1:{{ odyssai_pg_port_host_dev }}:{{ odyssai_pg_port }}/tcp"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_pg_memory }}
        reservations:
          memory: 256M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    stop_grace_period: 1m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # No companion bridge here: odyssai-internal-dev is already a plain one,
    # which is what lets redis-dev publish its own port just below.
    networks:
      - odyssai-internal-dev

  api-dev:
    image: {{ odyssai_api_dev_image }}
    container_name: {{ odyssai_api_dev_container_name }}
    restart: unless-stopped
    env_file: {{ odyssai_api_dev_env_file }}
    # NODE_ENV stays production on this copy too: the container runs the same
    # compiled build either way, and development would only change how Nest
    # reports errors while diverging from what production actually runs.
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_api_port }}"
      NODE_OPTIONS: --max-old-space-size={{ odyssai_api_heap_mb }}
    depends_on:
      redis-dev:
        condition: service_healthy
      db-dev:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_api_memory }}
        reservations:
          memory: 128M
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_api_port }}/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal-dev
      - traefik-public
    labels:
{% if odyssai_api_public %}
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ odyssai_api_dev_container_name }}.rule={{ odyssai_api_dev_router }}
      - traefik.http.routers.{{ odyssai_api_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_api_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_api_dev_container_name }}.loadbalancer.server.port={{ odyssai_api_port }}
{% else %}
      - traefik.enable=false
{% endif %}

  web-dev:
    image: {{ odyssai_web_dev_image }}
    container_name: {{ odyssai_web_dev_container_name }}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: "{{ odyssai_web_port }}"
      HOSTNAME: 0.0.0.0
      NODE_OPTIONS: --max-old-space-size={{ odyssai_web_heap_mb }}
      SITE_URL: {{ odyssai_dev_site_url }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: {{ odyssai_web_memory }}
        reservations:
          memory: 128M
    depends_on:
      - api-dev
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ odyssai_web_port }}/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - odyssai-internal-dev
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # No alias router here: the dev front answers on a single name, and
      # nothing should be indexing it anyway.
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.rule={{ odyssai_web_dev_router }}
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ odyssai_web_dev_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ odyssai_web_dev_container_name }}.loadbalancer.server.port={{ odyssai_web_port }}
{% endif %}

# Named rather than bound to a host path: the data is Redis's own format and
# nothing outside the container has any business reading it. Sessions have to
# survive a redeploy, so they cannot live in the container layer.
volumes:
  redis-data:
    name: {{ odyssai_app_name }}-redis-data
  db-data:
    name: {{ odyssai_app_name }}-db-data
{% if odyssai_dev_enabled | bool %}
  redis-dev-data:
    name: {{ odyssai_app_name }}-redis-dev-data
  db-dev-data:
    name: {{ odyssai_app_name }}-db-dev-data
{% endif %}

# Compose stamps every network it creates with the key used to declare it and
# then refuses to touch one whose stamp no longer matches, so these keys are
# fixed for the life of the stack — renaming one strands the running network.
networks:
  odyssai-internal:
    name: {{ odyssai_app_name }}-internal
    internal: true
  # Exists only so the production database can publish a port on the host:
  # an internal bridge has no route to it. Nothing else joins this network.
  odyssai-db-host:
    name: {{ odyssai_app_name }}-db-host
  traefik-public:
    name: traefik-public
    external: true
{% if odyssai_dev_enabled | bool %}
  odyssai-internal-dev:
    name: {{ odyssai_app_name }}-internal-dev
{% endif %}
