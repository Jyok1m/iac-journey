# {{ ansible_managed }}
#
# Read by the postgres image at startup. POSTGRES_PASSWORD is only honoured by
# initdb, on the very first boot of an empty volume: changing it here rotates
# nothing on a database that already exists — that takes an ALTER ROLE inside
# the server, and this file has to be updated to match in the same breath.
POSTGRES_DB={{ odyssai_pg_db }}
POSTGRES_USER={{ odyssai_pg_user }}
POSTGRES_PASSWORD={{ pg_password }}
