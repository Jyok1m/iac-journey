# {{ ansible_managed }}
#
# Validated by a Zod schema at boot, so a missing value fails the container
# rather than the first sign-in.

# These build the redirect_uri, drive the CORS allow-list and decide whether
# the session cookie is Secure, so they must match the realm's client exactly.
API_BASE_URL=https://{{ api_host }}
WEB_BASE_URL={{ web_url }}

# Confidential client: no password transits through the API, the realm's own
# pages handle sign-in.
KEYCLOAK_ISSUER={{ odyssai_keycloak_url }}/realms/{{ keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ odyssai_keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ keycloak_client_secret }}

# Session tokens live here; the browser only ever holds an opaque session id.
REDIS_URL=redis://:{{ redis_password }}@{{ redis_host }}:{{ odyssai_redis_port }}/0

# By container name over this copy's internal network, never through the
# loopback port published on the host.
POSTGRES_URL=postgresql://{{ odyssai_pg_user }}:{{ pg_password }}@{{ pg_host }}:{{ odyssai_pg_port }}/{{ odyssai_pg_db }}

# The browser never talks to the provider: this key only reaches the OpenAI
# compatible client, which is handed baseURL, organization and project
# explicitly so the SDK reads nothing from the environment of its own accord.
OPENROUTER_API_KEY={{ openrouter_api_key }}

LANGSMITH_TRACING={{ langsmith_tracing }}
LANGSMITH_ENDPOINT={{ odyssai_langsmith_endpoint }}
LANGSMITH_API_KEY={{ langsmith_api_key }}
LANGSMITH_PROJECT={{ langsmith_project }}

LLM_GUIDE_PROVIDER={{ odyssai_guide_provider }}
LLM_GUIDE_MODEL={{ odyssai_guide_model }}
# Single quotes: node's parseEnv strips them, and the value is JSON.
LLM_GUIDE_EXTRA_BODY='{{ odyssai_guide_extra_body }}'
LLM_GUIDE_TEMPERATURE={{ odyssai_guide_temperature }}
LLM_GUIDE_MAX_OUTPUT_TOKENS={{ odyssai_guide_max_output_tokens }}
LLM_GUIDE_PRICE_INPUT_USD_PER_MTOK={{ odyssai_guide_price_input }}
LLM_GUIDE_PRICE_OUTPUT_USD_PER_MTOK={{ odyssai_guide_price_output }}

GUIDE_ENABLED={{ guide_enabled }}
GUIDE_DAILY_BUDGET_USD={{ guide_daily_budget_usd }}
GUIDE_RATE_PER_HOUR={{ odyssai_guide_rate_per_hour }}
GUIDE_RATE_PER_DAY={{ odyssai_guide_rate_per_day }}
GUIDE_MAX_CONCURRENT={{ odyssai_guide_max_concurrent }}
GUIDE_PASS_QUESTIONS={{ odyssai_guide_pass_questions }}
GUIDE_PASS_TTL_SECONDS={{ odyssai_guide_pass_ttl_seconds }}
GUIDE_LOG_RETENTION_DAYS={{ odyssai_guide_log_retention_days }}
GUIDE_TRACE_SAMPLE_RATE={{ guide_trace_sample_rate }}
GUIDE_TRACE_HIDE_IO={{ odyssai_guide_trace_hide_io }}

# Per copy: shared, both copies would hash a visitor's address to the same key.
GUIDE_IP_HASH_SECRET={{ guide_ip_hash_secret }}

# The API refuses to boot with NODE_ENV=production and a Cloudflare test key
# (1x, 2x, 3x), which accepts every token.
TURNSTILE_SECRET_KEY={{ turnstile_secret_key }}

TRUST_PROXY={{ odyssai_trust_proxy }}
