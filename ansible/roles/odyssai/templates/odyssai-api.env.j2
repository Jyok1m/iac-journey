# {{ ansible_managed }}
#
# Validated by a Zod schema at boot, so a missing value fails the container
# rather than the first sign-in.

# These build the redirect_uri, drive the CORS allow-list and decide whether
# the session cookie is Secure — they must match the realm's client exactly.
API_BASE_URL=https://{{ api_host }}
WEB_BASE_URL={{ web_url }}

# Confidential client: no password transits through the API, the realm's own
# pages handle sign-in.
KEYCLOAK_ISSUER={{ odyssai_keycloak_url }}/realms/{{ keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ odyssai_keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ keycloak_client_secret }}

# Session tokens live here; the browser only ever holds an opaque session id.
REDIS_URL=redis://:{{ redis_password }}@{{ redis_host }}:{{ odyssai_redis_port }}/0

# By container name over this copy's internal network, never through the
# loopback port published on the host.
POSTGRES_URL=postgresql://{{ odyssai_pg_user }}:{{ pg_password }}@{{ pg_host }}:{{ odyssai_pg_port }}/{{ odyssai_pg_db }}
