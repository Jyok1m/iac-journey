# {{ ansible_managed }}
#
# Read by apps/api at boot. Every value here is validated by a Zod schema on
# startup, so a missing one fails the container immediately rather than the
# first player's sign-in.

# Public origins. They build the redirect_uri declared in Keycloak, drive the
# CORS allow-list, and decide whether the session cookie is Secure — so they
# have to match the realm's client exactly, scheme included.
API_BASE_URL=https://{{ api_host }}
WEB_BASE_URL={{ web_url }}

# Keycloak. The API is a confidential client and holds the secret; no password
# ever transits through it, the realm's own pages handle sign-in.
KEYCLOAK_ISSUER={{ odyssai_keycloak_url }}/realms/{{ keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ odyssai_keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ keycloak_client_secret }}

# Redis. Session tokens live here and never reach the browser, which only ever
# holds an opaque session id.
REDIS_URL=redis://:{{ redis_password }}@{{ redis_host }}:{{ odyssai_redis_port }}/0

# PostgreSQL. Reached by container name over this copy's own internal network,
# never through the loopback port published on the host — that one exists for
# psql, migrations and dumps run from a workstation, not for the application.
POSTGRES_URL=postgresql://{{ odyssai_pg_user }}:{{ pg_password }}@{{ pg_host }}:{{ odyssai_pg_port }}/{{ odyssai_pg_db }}
