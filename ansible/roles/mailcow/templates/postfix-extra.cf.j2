myhostname = {{ mailcow_hostname }}
# Ansible managed — do not edit manually.
#
# The host name directive above is deliberately the first line, and no comment
# in this file may contain that directive's name. postfix.sh rewrites the file
# on every container start: it deletes every line matching that name, then
# prepends its own copy. Omit the line and the rendered file differs from the
# running one by exactly that, so Ansible rewrites it and restarts Postfix on
# every run. Mention the name in a comment and postfix.sh deletes the comment,
# with the same result.
#
# main.cf is truncated at its "# Overrides #" marker and this file is
# concatenated on, so the last occurrence of a parameter wins. Postfix logs
# "duplicate parameter" warnings for these; upstream documents that as normal.
#
# WHY THIS EXISTS
# mailcow's defaults fail internet.nl's cipher subtests out of the box:
#   - smtpd_tls_ciphers is unset, so it falls back to Postfix's "medium",
#     whose exclusion list (!kDH:!kECDH) removes fixed DH but NOT static-RSA
#     key exchange. Port 25 therefore still offers AES256-GCM-SHA384 and
#     SHA-1-MAC suites, both of which internet.nl grades "insufficient" —
#     a zero, not a warning.
#   - smtpd_tls_mandatory_ciphers = high does not help: it only applies when
#     TLS is mandatory, and port 25 runs at security_level = may.
#   - tls_ffdhe_auto_groups is unset, so OpenSSL offers ffdhe2048 first.
#     internet.nl only accepts ffdhe3072 and above; 2048 is graded "bad".
#
# THE TRAP THIS AVOIDS
# The cipher-hardening recipe in mailcow's own docs writes
#   smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
# and postfix-mailcow's entrypoint greps for exactly that shape. On a match it
# appends "CipherString = DEFAULT@SECLEVEL=0" and "MinProtocol = TLSv1" to
# /etc/ssl/openssl.cnf for the whole container — which re-permits SHA-1 in
# TLS 1.2 signature algorithms and can fail the key-exchange hash subtest.
# The ">=TLSv1.2" form below expresses the same policy without matching that
# grep. Recorded as deviation TLS-1 in the decision log.

# Six suites, all Good or Sufficient by internet.nl's classification, none of
# them DHE — which removes the ffdhe2048 problem by construction rather than
# by trying to reorder around it.
tls_high_cipherlist = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
tls_preempt_cipherlist = yes

smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high

smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_ciphers = high
smtp_tls_mandatory_ciphers = high
