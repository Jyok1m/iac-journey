myhostname = {{ mailcow_hostname }}
# Ansible managed.
#
# The directive above must stay the first line, and no comment here may contain
# its name: postfix.sh deletes every matching line on container start and
# prepends its own. Either way the file would differ from the running one and
# Postfix would be restarted on every run.
#
# main.cf is truncated at its "# Overrides #" marker and this is concatenated
# on, so the last occurrence wins. The "duplicate parameter" warnings Postfix
# logs for these are documented upstream as normal.
#
# mailcow's defaults fail internet.nl's cipher subtests: smtpd_tls_ciphers
# falls back to "medium", which still offers static-RSA and SHA-1-MAC suites,
# and tls_ffdhe_auto_groups is unset so OpenSSL offers ffdhe2048.
#
# The floor says ">=TLSv1.2" rather than the "!SSLv3, !TLSv1" form mailcow's
# own docs use: postfix-mailcow's entrypoint greps for that shape and, on a
# match, drops the whole container's OpenSSL to SECLEVEL=0. Deviation TLS-1.
#
# Six AEAD suites, none of them DHE — which removes the ffdhe2048 problem by
# construction rather than by reordering around it.
tls_high_cipherlist = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
tls_preempt_cipherlist = yes

smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high

smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_ciphers = high
smtp_tls_mandatory_ciphers = high
