# Ansible managed. Certificates renew on Traefik's schedule, not Ansible's:
# without this, Postfix and Dovecot would serve an expired one until the next
# playbook run.

[Unit]
Description=Watch Traefik's ACME store for certificates mailcow needs
After={{ mailcow_cert_sync_unit }}.service

[Path]
PathChanged={{ mailcow_traefik_acme_store }}
Unit={{ mailcow_cert_sync_unit }}.service

[Install]
WantedBy=multi-user.target
