# Ansible managed. Merged over the upstream docker-compose.yml, which stays
# untouched so `git checkout` of a new tag is a clean fast-forward.

services:
  nginx-mailcow:
    networks:
      # Repeated because compose replaces the list rather than appending;
      # dropping it would cut nginx off from php-fpm.
      mailcow-network:
        aliases:
          - nginx
      {{ mailcow_traefik_network }}: {}
    labels:
      - traefik.enable=true
      - traefik.docker.network={{ mailcow_traefik_network }}
      - traefik.http.routers.mailcow.rule={{ mailcow_router_rule }}
      - traefik.http.routers.mailcow.entrypoints=websecure
      - traefik.http.routers.mailcow.tls.certresolver={{ mailcow_traefik_acme_resolver }}
      - traefik.http.routers.mailcow.service=mailcow
{% for host in [mailcow_hostname] + mailcow_additional_server_names %}
      - traefik.http.routers.mailcow.tls.domains[{{ loop.index0 }}].main={{ host }}
{% endfor %}
      # Traefik terminates TLS for the web surface; the certificate Postfix
      # and Dovecot serve is the {{ mailcow_cert_sync_unit }} unit's job.
      - traefik.http.services.mailcow.loadbalancer.server.port={{ mailcow_http_port }}
      - traefik.http.services.mailcow.loadbalancer.server.scheme=http

# No volume override for postfix-mailcow: upstream already mounts the whole
# ./data/conf/postfix directory. Bind-mounting the single file broke
# postfix.sh — its `sed -i` renames a temp file into place, which fails with
# EBUSY across a bind-mount point, so its dedupe step silently did nothing.

networks:
  {{ mailcow_traefik_network }}:
    external: true
