# Ansible managed — do not edit manually.
#
# dovecot.conf ends with `!include_try /etc/dovecot/extra.conf`, so everything
# here overrides what came before it. The whole data/conf/dovecot directory is
# mounted into the container, so this file needs no volume of its own.
#
# WHY THIS EXISTS
# mailcow ships ssl_cipher_list = ALL:!ADH:!LOW:...:+HIGH:+MEDIUM, which still
# offers CBC suites. testssl.sh reports the resulting port 993 as potentially
# vulnerable to LUCKY13 (CVE-2013-0169) on that basis. The same list also
# leaves DHE available, and mailcow's shipped dhparams.pem is a 2048-bit
# RFC 7919 group — below the 3072-bit floor that current guidance wants.
#
# Restricting the list to six AEAD suites removes both at once: no CBC, so no
# LUCKY13, and no DHE at all, so the DH group size stops mattering rather than
# needing a larger file generated and shipped.
#
# The TLS 1.3 suites are negotiated separately and already good by default, so
# they are deliberately left alone.
#
# NOTE the protocol floor below says TLSv1.2 and must keep saying that.
# dovecot's entrypoint greps its config for a floor of TLSv1 or TLSv1.1 and,
# on a match, drops OpenSSL to SECLEVEL=0 for the whole container — the same
# trap the Postfix side has.

ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes
ssl_cipher_list = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
