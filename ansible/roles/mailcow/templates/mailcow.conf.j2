# Ansible managed. Do not run generate_config.sh against it: it is interactive,
# it overwrites rather than merges, and its IPv6 step offers to restart the
# Docker daemon. Every value it would produce is set here, with the four
# secrets taken from the vault so a rebuild reaches the same state.

MAILCOW_HOSTNAME={{ mailcow_hostname }}
MAILCOW_PASS_SCHEME=BLF-CRYPT

# Unrecoverable once the databases are initialised: these are not read at
# runtime, they are what the stored credentials already are.
DBNAME=mailcow
DBUSER=mailcow
DBPASS={{ mailcow_vault_dbpass }}
DBROOT={{ mailcow_vault_dbroot }}
REDISPASS={{ mailcow_vault_redispass }}

# Host port == container port by design, so changing these moves nginx's
# listen directive too. Loopback: Traefik reaches the container over docker.
HTTP_PORT={{ mailcow_http_port }}
HTTP_BIND={{ mailcow_http_bind }}
HTTPS_PORT={{ mailcow_https_port }}
HTTPS_BIND={{ mailcow_https_bind }}

# Traefik already redirects web to websecure at the entrypoint.
HTTP_REDIRECT=n

SMTP_PORT={{ mailcow_ports['smtp'] }}
SMTPS_PORT={{ mailcow_ports['smtps'] }}
SUBMISSION_PORT={{ mailcow_ports['submission'] }}
IMAP_PORT={{ mailcow_ports['imap'] }}
IMAPS_PORT={{ mailcow_ports['imaps'] }}
POP_PORT={{ mailcow_ports['pop'] }}
POPS_PORT={{ mailcow_ports['pops'] }}
SIEVE_PORT={{ mailcow_ports['sieve'] }}

# Loopback only, as upstream requires.
DOVEADM_PORT=127.0.0.1:19991
SQL_PORT=127.0.0.1:13306
REDIS_PORT=127.0.0.1:7654

TZ={{ mailcow_timezone }}
COMPOSE_PROJECT_NAME={{ mailcow_compose_project }}
DOCKER_COMPOSE_VERSION=native

ACL_ANYONE=disallow
MAILDIR_GC_TIME=7200

# acme-mailcow off: Traefik is the single ACME client here and the
# {{ mailcow_cert_sync_unit }} unit copies the certificates in.
SKIP_LETS_ENCRYPT={{ 'y' if mailcow_skip_lets_encrypt else 'n' }}
ACME_DNS_CHALLENGE=n
ACME_DNS_PROVIDER=dns_xxx
ACME_ACCOUNT_EMAIL={{ mailcow_acme_email }}
ADDITIONAL_SAN=
AUTODISCOVER_SAN=n

# Without these, nginx answers an unrecognised name with the wrong site.
ADDITIONAL_SERVER_NAMES={{ mailcow_additional_server_names | join(',') }}

ENABLE_SSL_SNI=n
SKIP_IP_CHECK=n
SKIP_HTTP_VERIFICATION=n
SKIP_UNBOUND_HEALTHCHECK=n
SKIP_CLAMD={{ 'y' if mailcow_skip_clamd else 'n' }}
SKIP_OLEFY=n
SKIP_SOGO=n
SKIP_FTS={{ 'y' if mailcow_skip_fts else 'n' }}
FTS_HEAP={{ mailcow_fts_heap }}
FTS_PROCS={{ mailcow_fts_procs }}

ALLOW_ADMIN_EMAIL_LOGIN=n

USE_WATCHDOG=y
WATCHDOG_NOTIFY_BAN=n
WATCHDOG_NOTIFY_START=y
WATCHDOG_EXTERNAL_CHECKS=n
WATCHDOG_VERBOSE=n
LOG_LINES=9999

IPV4_NETWORK={{ mailcow_ipv4_network }}
IPV6_NETWORK={{ mailcow_ipv6_network }}

# Off: enabling it needs a Docker daemon restart, which would bounce every
# other stack. Inbound IPv6 to the published ports works regardless.
ENABLE_IPV6={{ mailcow_enable_ipv6 | lower }}

DISABLE_NETFILTER_ISOLATION_RULE=n

MAILDIR_SUB=Maildir
SOGO_EXPIRE_SESSION=480
# Exactly 16 characters: SOGo derives its URL cipher from this.
SOGO_URL_ENCRYPTION_KEY={{ mailcow_vault_sogo_key }}

# mailcow generates and rotates these itself on start.
DOVECOT_MASTER_USER=
DOVECOT_MASTER_PASS=

WEBAUTHN_ONLY_TRUSTED_VENDORS=n
SPAMHAUS_DQS_KEY=

# The phpfpm entrypoint reseeds the `api` table from these on every start.
# API_KEY is ignored unless API_ALLOW_FROM validates to a non-empty list.
# {{ mailcow_ipv4_network }}.1 is what the container sees for a call from the
# host over the published loopback port.
API_KEY={{ mailcow_vault_api_key }}
API_ALLOW_FROM={{ mailcow_api_allow_from | join(',') }}
