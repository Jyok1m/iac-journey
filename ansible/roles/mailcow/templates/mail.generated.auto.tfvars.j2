# Generated by the ansible mailcow role — do not edit by hand.
#
# These two values cannot be written down ahead of time: the DKIM key does not
# exist until mailcow has been installed and the domain created inside it, and
# the MTA-STS policy is only announced once mailcow is actually serving it.
#
# They live in a file rather than being passed as -var on the command line so
# that the Terraform configuration is complete on its own. With -var, a bare
# `terraform plan` run by hand saw mail_dkim_txt default to "" and planned to
# DESTROY the live DKIM record — a loaded gun for anyone who ran plan without
# knowing the incantation. Nothing here is secret: a DKIM public key is
# published in DNS by definition.

mail_dkim_txt        = {{ mailcow_dkim_txt | to_json }}
mail_dkim_selector   = {{ mailcow_dkim_selector | to_json }}
mail_mta_sts_enabled = {{ mailcow_mta_sts_serving | lower }}
