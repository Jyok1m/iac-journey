# Generated by the ansible mailcow role — do not edit by hand.
#
# These values cannot be written down ahead of time: a DKIM key does not exist
# until mailcow has been installed and the domain created inside it, and an
# MTA-STS policy is only announced once mailcow is actually serving it. Both
# are per-domain, so both are maps; a domain absent from either map keeps the
# corresponding record out of the plan entirely.
#
# They live in a file rather than being passed as -var on the command line so
# that the Terraform configuration is complete on its own. With -var, a bare
# `terraform plan` run by hand saw mail_dkim default to {} and planned to
# DESTROY the live DKIM record — a loaded gun for anyone who ran plan without
# knowing the incantation. Nothing here is secret: a DKIM public key is
# published in DNS by definition.

mail_dkim_selector = {{ mailcow_dkim_selector | to_json }}

{# Keys are padded so the rendered file survives `terraform fmt -check`, which
   aligns the `=` of a map's entries. Without this every ansible run rewrites
   the file into a shape fmt wants to change back. #}
{% set width = (mailcow_domain_names | map('length') | max) + 2 %}
mail_dkim = {
{% for d in mailcow_domain_names %}
{% if mailcow_dkim.get(d, '') | length > 0 %}
  {{ (d | to_json).ljust(width) }} = {{ mailcow_dkim[d] | to_json }}
{% endif %}
{% endfor %}
}

mail_mta_sts_serving = {
{% for d in mailcow_mta_sts_domains %}
  {{ (d | to_json).ljust(width) }} = {{ 'true' if mailcow_mta_sts_serving.get(d, false) else 'false' }}
{% endfor %}
}
