# Generated by the ansible mailcow role: do not edit by hand.
#
# Neither value can be written ahead of time, and a domain absent from either
# map keeps its record out of the plan. In a file rather than passed as -var so
# the configuration stands on its own: with -var, a bare `terraform plan` saw
# mail_dkim default to {} and planned to DESTROY the live DKIM record.

mail_dkim_selector = {{ mailcow_dkim_selector | to_json }}

{# Padded so the file survives `terraform fmt -check`, which aligns the `=`. #}
{% set width = (mailcow_domain_names | map('length') | max) + 2 %}
mail_dkim = {
{% for d in mailcow_domain_names %}
{% if mailcow_dkim.get(d, '') | length > 0 %}
  {{ (d | to_json).ljust(width) }} = {{ mailcow_dkim[d] | to_json }}
{% endif %}
{% endfor %}
}

mail_mta_sts_serving = {
{% for d in mailcow_mta_sts_domains %}
  {{ (d | to_json).ljust(width) }} = {{ 'true' if mailcow_mta_sts_serving.get(d, false) else 'false' }}
{% endfor %}
}
