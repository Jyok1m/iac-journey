---
services:
  n8n-db:
    image: {{ n8n_db_image }}
    container_name: {{ n8n_db_container_name }}
    restart: unless-stopped
    env_file: {{ n8n_db_env_file }}
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 1G
        reservations:
          memory: 256M
    # Credentials come from the container's own environment rather than being
    # baked into the compose file, which keeps them out of `docker inspect`.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    volumes:
      - n8n-db:/var/lib/postgresql/data
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - n8n-internal

  n8n:
    image: {{ n8n_image }}
    container_name: {{ n8n_container_name }}
    restart: unless-stopped
    env_file: {{ n8n_env_file }}
    depends_on:
      n8n-db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 4G
        reservations:
          memory: 512M
    volumes:
      - n8n:/home/node/.n8n
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - n8n-internal
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      # Canonical host
      - traefik.http.routers.{{ n8n_container_name }}.rule=Host(`{{ n8n_host }}`)
      - traefik.http.routers.{{ n8n_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ n8n_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ n8n_container_name }}.loadbalancer.server.port=5678
      # Permanent redirect from the .fr to the canonical .com
      - traefik.http.routers.{{ n8n_container_name }}-redirect.rule=Host(`{{ n8n_redirect_host }}`)
      - traefik.http.routers.{{ n8n_container_name }}-redirect.entrypoints=websecure
      - traefik.http.routers.{{ n8n_container_name }}-redirect.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ n8n_container_name }}-redirect.service={{ n8n_container_name }}
      - traefik.http.routers.{{ n8n_container_name }}-redirect.middlewares={{ n8n_container_name }}-redirect
      - traefik.http.middlewares.{{ n8n_container_name }}-redirect.redirectregex.regex=^https?://{{ n8n_redirect_host | replace('.', '\\.') }}/(.*)
      - traefik.http.middlewares.{{ n8n_container_name }}-redirect.redirectregex.replacement=https://{{ n8n_host }}/$${1}
      - traefik.http.middlewares.{{ n8n_container_name }}-redirect.redirectregex.permanent=true

# Keys frozen on what the running stack was built with: Compose refuses to
# adopt a network or volume whose com.docker.compose.* label no longer matches.
volumes:
  n8n:
    name: n8n
  n8n-db:
    name: n8n-db

networks:
  n8n-internal:
    name: n8n-internal
    internal: true
  traefik-public:
    name: traefik-public
    external: true
