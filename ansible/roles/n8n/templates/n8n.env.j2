DB_TYPE=postgresdb
DB_POSTGRESDB_HOST={{ n8n_db_container_name }}
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE={{ n8n_db_name }}
DB_POSTGRESDB_USER={{ n8n_vault_db_user }}
DB_POSTGRESDB_PASSWORD={{ n8n_vault_db_password }}

# Credentials stored in workflows are encrypted with this key. Losing it makes
# every saved credential unrecoverable.
N8N_ENCRYPTION_KEY={{ n8n_vault_encryption_key }}

# Public addressing — n8n builds webhook URLs from these.
N8N_HOST={{ n8n_host }}
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://{{ n8n_host }}
WEBHOOK_URL=https://{{ n8n_host }}/
# One proxy in front (Traefik), so trust exactly one X-Forwarded-For hop.
N8N_PROXY_HOPS=1

GENERIC_TIMEZONE={{ n8n_timezone }}
TZ={{ n8n_timezone }}
