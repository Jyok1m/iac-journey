---
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    host: {{ monitoring_external_host_label }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node-exporter
    static_configs:
      - targets: ["{{ monitoring_node_exporter_container_name }}:9100"]

  - job_name: cadvisor
    static_configs:
      - targets: ["{{ monitoring_cadvisor_container_name }}:8080"]
{% if monitoring_is_edge %}

  - job_name: traefik
    static_configs:
      - targets: ["{{ monitoring_traefik_metrics_target }}"]
{% endif %}
{% if monitoring_is_hub %}

  - job_name: grafana
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ monitoring_grafana_container_name }}:3000"]
{% for leaf in monitoring_federation_targets %}

  - job_name: federate-{{ leaf.name }}
    honor_labels: true
    metrics_path: /federate
    params:
      'match[]':
        - '{job!=""}'
    static_configs:
      - targets:
          - "{{ leaf.target }}"
{% endfor %}
{% endif %}
