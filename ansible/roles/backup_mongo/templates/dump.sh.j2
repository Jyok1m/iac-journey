#!/usr/bin/env bash
# Managed by Ansible — backup_mongo ({{ backup_mongo_name }})
#
# Dumps the Mongo instance to a local gzip archive, pushes it to restic, then
# applies the retention policy. Invoked by the systemd timer of the same name.
set -euo pipefail

NAME="{{ backup_mongo_name }}"
LOCAL_DIR="{{ backup_mongo_local_dir }}"
CONTAINER="{{ backup_mongo_container }}"
NETWORK="{{ backup_mongo_network }}"
IMAGE="{{ backup_mongo_image }}"
PORT="{{ backup_mongo_port }}"
AUTHDB="{{ backup_mongo_authdb }}"
DB="{{ backup_mongo_db }}"
KEEP_LOCAL="{{ backup_mongo_local_keep }}"

# systemd already injects these through EnvironmentFile. Sourcing them here as
# well is what makes a manual run behave exactly like a scheduled one.
ENV_FILE="/etc/backup-mongo-${NAME}.env"
if [[ ! -r "${ENV_FILE}" ]]; then
  echo "[${NAME}] env file ${ENV_FILE} is not readable" >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a

mkdir -p "${LOCAL_DIR}"
chmod 0700 "${LOCAL_DIR}"

TS="$(date -u +%Y%m%dT%H%M%SZ)"
ARCHIVE="${LOCAL_DIR}/${NAME}-${TS}.archive.gz"

# A dump that dies halfway still leaves the redirection target behind. Dropping
# it keeps a truncated archive from being mistaken for a usable one later.
trap 'rm -f "${ARCHIVE}"' ERR

DUMP_ARGS=(
  --host "${CONTAINER}:${PORT}"
  --username "${MONGO_USERNAME}"
  --password "${MONGO_PASSWORD}"
  --authenticationDatabase "${AUTHDB}"
  --archive
  --gzip
)
if [[ -n "${DB}" ]]; then
  DUMP_ARGS+=(--db "${DB}")
fi

echo "[${NAME}] mongodump → ${ARCHIVE}"
docker run --rm --network "${NETWORK}" "${IMAGE}" \
  mongodump "${DUMP_ARGS[@]}" > "${ARCHIVE}"

{% if backup_mongo_restic_init %}
echo "[${NAME}] ensure the restic repository exists"
restic cat config >/dev/null 2>&1 || restic init
{% endif %}

echo "[${NAME}] restic backup"
restic backup \
  --tag backup_mongo \
  --tag "${NAME}" \
  --host "$(hostname -s)" \
  "${ARCHIVE}"

echo "[${NAME}] restic forget --prune"
restic forget \
  --prune \
  --tag "${NAME}" \
  --keep-daily {{ backup_mongo_keep_daily }} \
  --keep-weekly {{ backup_mongo_keep_weekly }} \
  --keep-monthly {{ backup_mongo_keep_monthly }}

echo "[${NAME}] trim local archives (keep ${KEEP_LOCAL})"
ls -1t "${LOCAL_DIR}/${NAME}"-*.archive.gz 2>/dev/null \
  | tail -n +$((KEEP_LOCAL + 1)) \
  | xargs -r rm -f --

echo "[${NAME}] done"
