# Production stack — copy to the deploy host (e.g. /opt/heirloom/docker-compose.yml)
# alongside a .env. The Jenkins pipeline drives it: `docker compose pull`,
# `docker compose run --rm migrate`, `docker compose up -d api app`.
#
# Images come from Docker Hub (built by CI), so no build: context here.
# DATABASE_URL is composed from POSTGRES_* and points at the `db` service
# (the value in .env targets localhost for local dev — overridden below).

x-db-url: &db-url
  DATABASE_URL: postgresql://${POSTGRES_USER:-heirloom}:${POSTGRES_PASSWORD:-changeme}@db:5432/${POSTGRES_DB:-heirloom}

services:
  db:
    image: postgres:18.4-trixie
    container_name: heirloom-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-heirloom}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-changeme}
      POSTGRES_DB: ${POSTGRES_DB:-heirloom}
    volumes:
      - db_data:/var/lib/postgresql
    networks: [heirloom]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-heirloom}"]
      interval: 5s
      timeout: 3s
      retries: 10

  # One-shot migrations. Not started by `up`; run explicitly before deploy:
  #   docker compose run --rm migrate
  migrate:
    image: jyok1m/heirloom-api:migrate
    profiles: ["tools"]
    container_name: heirloom-migrate
    env_file: .env
    environment:
      <<: *db-url
    depends_on:
      db:
        condition: service_healthy
    networks: [heirloom]
    restart: "no"

  api:
    image: jyok1m/heirloom-api:main
    container_name: heirloom-api
    restart: unless-stopped
    env_file: .env
    environment:
      <<: *db-url
      NODE_ENV: production
    volumes:
      - media:/prod/data/media
    depends_on:
      db:
        condition: service_healthy
    networks:
      - heirloom
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.http.routers.heirloom-api.rule=Host(`heirloom-api.{{ portfolio_domain_com }}`) || Host(`heirloom-api.{{ portfolio_domain_fr }}`)
      - traefik.http.routers.heirloom-api.entrypoints=websecure
      - traefik.http.routers.heirloom-api.tls.certresolver=letsencrypt
      - traefik.http.services.heirloom-api.loadbalancer.server.port=3000

  app:
    image: jyok1m/heirloom-app:main
    container_name: heirloom-app
    restart: unless-stopped
    # nginx proxies /api and /graphql to the `api` service (see nginx.conf).
    depends_on:
      - api
    networks:
      - heirloom
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.http.routers.heirloom.rule=Host(`heirloom.{{ portfolio_domain_com }}`) || Host(`heirloom.{{ portfolio_domain_fr }}`)
      - traefik.http.routers.heirloom.entrypoints=websecure
      - traefik.http.routers.heirloom.tls.certresolver=letsencrypt
      - traefik.http.services.heirloom.loadbalancer.server.port=80

networks:
  heirloom:
  traefik-public:
    name: traefik-public
    external: true

volumes:
  db_data:
  media:
