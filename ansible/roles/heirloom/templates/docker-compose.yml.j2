---
services:
  db:
    image: {{ heirloom_pg_image }}
    container_name: {{ heirloom_pg_container_name }}
    restart: unless-stopped
    env_file: {{ heirloom_pg_env_file }}
    volumes:
      - db_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ vault_db_user }} -d {{ vault_db }}"]
      interval: 5s
      timeout: 3s
      retries: 10
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - private

  # One-shot migrations. Not started by `up`; run explicitly before deploy:
  #   docker compose run --rm migrate
  migrate:
    image: {{ heirloom_migrate_image }}
    container_name: {{ heirloom_migrate_container_name }}
    profiles: ["tools"]
    restart: "no"
    env_file: {{ heirloom_api_env_file }}
    depends_on:
      db:
        condition: service_healthy
    networks:
      - private

  api:
    image: {{ heirloom_api_image }}
    container_name: {{ heirloom_api_container_name }}
    restart: unless-stopped
    env_file: {{ heirloom_api_env_file }}
    environment:
      NODE_ENV: production
    volumes:
      - media:/prod/data/media
    depends_on:
      db:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - private
      - app
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ heirloom_api_container_name }}.rule={{ heirloom_api_router }}
      - traefik.http.routers.{{ heirloom_api_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ heirloom_api_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ heirloom_api_container_name }}.loadbalancer.server.port=3000

  app:
    image: {{ heirloom_app_image }}
    container_name: {{ heirloom_app_container_name }}
    restart: unless-stopped
    depends_on:
      - api
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - app
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ heirloom_app_name }}.rule={{ heirloom_app_router }}
      - traefik.http.routers.{{ heirloom_app_name }}.entrypoints=websecure
      - traefik.http.routers.{{ heirloom_app_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ heirloom_app_name }}.loadbalancer.server.port=80

  web:
    image: {{ heirloom_web_image }}
    container_name: {{ heirloom_web_container_name }}
    restart: unless-stopped
    env_file: {{ heirloom_web_env_file }}
    depends_on:
      - app
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - traefik-public
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ heirloom_web_container_name }}.rule={{ heirloom_web_router }}
      - traefik.http.routers.{{ heirloom_web_container_name }}.entrypoints=websecure
      - traefik.http.routers.{{ heirloom_web_container_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ heirloom_web_container_name }}.loadbalancer.server.port=80

networks:
  private:
    name: heirloom_private
    internal: true
  app:
    name: heirloom_app
  traefik-public:
    name: traefik-public
    external: true

volumes:
  db_data:
    name: heirloom_db_data
  media:
    name: heirloom_media
