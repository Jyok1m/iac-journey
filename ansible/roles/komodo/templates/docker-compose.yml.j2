---
services:
  mongo:
    image: {{ komodo_mongo_image }}
    container_name: {{ komodo_mongo_container_name }}
    restart: unless-stopped
    env_file: {{ komodo_env_file }}
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 512M
        reservations:
          memory: 256M
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    command: --quiet --wiredTigerCacheSizeGB 0.25
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - internal

  core:
    image: {{ komodo_core_image }}
    container_name: {{ komodo_core_container_name }}
    init: true
    restart: unless-stopped
    depends_on:
      - mongo
    env_file: {{ komodo_env_file }}
    environment:
      KOMODO_DATABASE_ADDRESS: mongo:27017
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512M
        reservations:
          memory: 128M
    volumes:
      - keys:/config/keys
      - {{ komodo_backups_path }}:/backups
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ komodo_app_name }}.rule={{ komodo_core_router }}
      - traefik.http.routers.{{ komodo_app_name }}.entrypoints=websecure
      - traefik.http.routers.{{ komodo_app_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ komodo_app_name }}.loadbalancer.server.port=9120
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - internal
      - traefik-public

  periphery:
    image: {{ komodo_periphery_image }}
    container_name: {{ komodo_periphery_container_name }}
    init: true
    restart: unless-stopped
    depends_on:
      - core
    env_file: {{ komodo_env_file }}
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 512M
        reservations:
          memory: 64M
    volumes:
      - keys:/config/keys
      - /var/run/docker.sock:/var/run/docker.sock
      - /proc:/proc
      ## Same path in and out: Periphery hands compose file paths to the
      ## host daemon, which has to resolve them.
      - {{ komodo_periphery_root_dir }}:{{ komodo_periphery_root_dir }}
      ## Stacks rendered by Ansible, same path for the same reason.
      ## Read-write because Komodo writes a project .env on deploy — but
      ## Ansible stays the source of truth, so the Komodo file editor is a
      ## debugging tool, not somewhere to make a change that should survive.
      - {{ komodo_stacks_dir }}:{{ komodo_stacks_dir }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - internal

networks:
  internal:
    name: komodo_internal
    internal: true
  traefik-public:
    name: traefik-public
    external: true

volumes:
  mongo-data:
  mongo-config:
  keys:
