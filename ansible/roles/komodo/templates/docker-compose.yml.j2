---
services:
  mongo:
    image: {{ komodo_mongo_image }}
    container_name: {{ komodo_mongo_container_name }}
    restart: unless-stopped
    env_file: {{ komodo_env_file }}
    labels:
      komodo.skip: # Prevent Komodo from stopping with StopAllContainers
    command: --quiet --wiredTigerCacheSizeGB 0.25
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb
    networks:
      - internal

  core:
    image: {{ komodo_core_image }}
    container_name: {{ komodo_core_container_name }}
    init: true
    restart: unless-stopped
    depends_on:
      - mongo
    env_file: {{ komodo_env_file }}
    environment:
      KOMODO_DATABASE_ADDRESS: mongo:27017
    volumes:
      - keys:/config/keys
      - {{ komodo_backups_path }}:/backups
    labels:
      - traefik.enable=true
      - traefik.docker.network=traefik-public
      - traefik.http.routers.{{ komodo_app_name }}.rule={{ komodo_core_router }}
      - traefik.http.routers.{{ komodo_app_name }}.entrypoints=websecure
      - traefik.http.routers.{{ komodo_app_name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ komodo_app_name }}.loadbalancer.server.port=9120
    networks:
      - internal
      - traefik-public

  periphery:
    image: {{ komodo_periphery_image }}
    container_name: {{ komodo_periphery_container_name }}
    init: true
    restart: unless-stopped
    depends_on:
      - core
    env_file: {{ komodo_env_file }}
    volumes:
      - keys:/config/keys
      ## Mount external docker socket
      - /var/run/docker.sock:/var/run/docker.sock
      ## Allow Periphery to see processes outside of container
      - /proc:/proc
      ## Same path inside and outside the container: Periphery hands compose
      ## file paths to the host docker daemon.
      - {{ komodo_periphery_root_dir }}:{{ komodo_periphery_root_dir }}
    networks:
      - internal

networks:
  internal:
    name: komodo_internal
    internal: true
  traefik-public:
    name: traefik-public
    external: true

volumes:
  mongo-data:
  mongo-config:
  keys:
