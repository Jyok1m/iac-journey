# Images, backups path and Periphery root dir are rendered straight into
# docker-compose.yml: Compose only interpolates ${...} from the shell env and
# from a file literally named `.env`, never from `env_file:`.

MONGO_INITDB_ROOT_USERNAME={{ komodo_vault_database_user }}
MONGO_INITDB_ROOT_PASSWORD={{ komodo_vault_database_password }}
KOMODO_DATABASE_USERNAME={{ komodo_vault_database_user }}
KOMODO_DATABASE_PASSWORD={{ komodo_vault_database_password }}

TZ=Europe/Paris

# Core, full variable list:
# https://github.com/moghtech/komodo/blob/main/config/core.config.toml

KOMODO_HOST=https://komodo.{{ portfolio_domain_com }}
KOMODO_TITLE=Komodo
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=false
KOMODO_FIRST_SERVER_NAME="Portfolio Server"
KOMODO_DISABLE_CONFIRM_DIALOG=false
KOMODO_DISABLE_INIT_RESOURCES=false
KOMODO_DEFAULT_PAGINATION_LIMIT=50

KOMODO_WEBHOOK_SECRET={{ komodo_vault_webhook_secret }}
KOMODO_JWT_SECRET={{ komodo_vault_jwt_secret }}
KOMODO_JWT_TTL="1-day"

KOMODO_MONITORING_INTERVAL="15-sec"
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

KOMODO_DISABLE_USER_REGISTRATION=false
KOMODO_ENABLE_NEW_USERS=true
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_TRANSPARENT_MODE=false

KOMODO_OIDC_ENABLED=true
KOMODO_OIDC_PROVIDER=https://sso.{{ portfolio_domain_com }}/realms/lab
KOMODO_OIDC_CLIENT_ID=komodo
KOMODO_OIDC_CLIENT_SECRET={{ komodo_vault_oidc_client_secret }}
KOMODO_OIDC_USE_FULL_EMAIL=true

KOMODO_GITHUB_OAUTH_ENABLED=false
KOMODO_GOOGLE_OAUTH_ENABLED=false
KOMODO_AWS_ACCESS_KEY_ID=
KOMODO_AWS_SECRET_ACCESS_KEY=

KOMODO_LOGGING_PRETTY=false
KOMODO_PRETTY_STARTUP_CONFIG=false

# Periphery, full variable list:
# https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml

PERIPHERY_CORE_ADDRESS=ws://core:9120
# Must match KOMODO_FIRST_SERVER_NAME for the agent to connect.
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
# Every compose file and repo Periphery touches must live under this directory.
PERIPHERY_ROOT_DIRECTORY={{ komodo_periphery_root_dir }}

PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false
# Whitelist, otherwise the reported disk size is wildly over.
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname

PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
