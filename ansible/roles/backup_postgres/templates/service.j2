[Unit]
Description=Postgres dump + restic push ({{ backup_postgres_name }})
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/usr/local/bin/backup-postgres-dump-{{ backup_postgres_name }}.sh

[Service]
Type=oneshot
EnvironmentFile=/etc/backup-postgres-{{ backup_postgres_name }}.env
ExecStart=/usr/local/bin/backup-postgres-dump-{{ backup_postgres_name }}.sh
# A dump competes with the live workload for disk: keep it out of the way.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
