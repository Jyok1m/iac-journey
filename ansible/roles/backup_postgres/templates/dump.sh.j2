#!/usr/bin/env bash
# Managed by Ansible: backup_postgres ({{ backup_postgres_name }})
#
# Dumps the database to a local custom-format archive, checks that the archive
# is readable, pushes it to restic, then applies the retention policy. Invoked
# by the systemd timer of the same name.
#
# Custom format (-Fc) rather than plain SQL: it is compressed, it restores with
# pg_restore, and its table of contents can be listed, which is what makes the
# check below possible. A gzipped SQL file offers no such thing.
set -euo pipefail

NAME="{{ backup_postgres_name }}"
LOCAL_DIR="{{ backup_postgres_local_dir }}"
CONTAINER="{{ backup_postgres_container }}"
NETWORK="{{ backup_postgres_network }}"
IMAGE="{{ backup_postgres_image }}"
PORT="{{ backup_postgres_port }}"
KEEP_LOCAL="{{ backup_postgres_local_keep }}"

# systemd injects these through EnvironmentFile; sourcing them makes a manual
# run behave like a scheduled one.
ENV_FILE="/etc/backup-postgres-${NAME}.env"
if [[ ! -r "${ENV_FILE}" ]]; then
  echo "[${NAME}] env file ${ENV_FILE} is not readable" >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a

mkdir -p "${LOCAL_DIR}"
chmod 0700 "${LOCAL_DIR}"

TS="$(date -u +%Y%m%dT%H%M%SZ)"
ARCHIVE="${LOCAL_DIR}/${NAME}-${TS}.dump"

# A dump that dies halfway leaves its redirection target behind, and a
# truncated archive must not be mistaken for a usable one.
trap 'rm -f "${ARCHIVE}"' ERR

# PGPASSWORD travels as an environment variable rather than in the URL: the
# command line of a container is readable by anyone who can run `docker ps`.
echo "[${NAME}] pg_dump → ${ARCHIVE}"
docker run --rm --network "${NETWORK}" \
  -e PGPASSWORD \
  "${IMAGE}" \
  pg_dump \
  --host "${CONTAINER}" \
  --port "${PORT}" \
  --username "${PGUSER}" \
  --dbname "${PGDATABASE}" \
  --format=custom \
  --no-owner \
  --no-privileges \
  > "${ARCHIVE}"

# An archive nobody has read is not a backup. Listing the table of contents
# catches a truncated or empty dump here, where it still costs nothing, rather
# than on the day it has to be restored.
echo "[${NAME}] verify the archive is readable"
ENTRIES="$(docker run --rm -i "${IMAGE}" pg_restore --list < "${ARCHIVE}" | grep -c ';' || true)"
if [[ "${ENTRIES}" -lt 1 ]]; then
  echo "[${NAME}] the archive holds no entry, refusing to push it" >&2
  exit 3
fi
echo "[${NAME}] archive holds ${ENTRIES} entries"

{% if backup_postgres_restic_init %}
echo "[${NAME}] ensure the restic repository exists"
restic cat config >/dev/null 2>&1 || restic init
{% endif %}

echo "[${NAME}] restic backup"
restic backup \
  --tag backup_postgres \
  --tag "${NAME}" \
  --host "$(hostname -s)" \
  "${ARCHIVE}"

echo "[${NAME}] restic forget --prune"
restic forget \
  --prune \
  --tag "${NAME}" \
  --keep-daily {{ backup_postgres_keep_daily }} \
  --keep-weekly {{ backup_postgres_keep_weekly }} \
  --keep-monthly {{ backup_postgres_keep_monthly }}

echo "[${NAME}] trim local archives (keep ${KEEP_LOCAL})"
ls -1t "${LOCAL_DIR}/${NAME}"-*.dump 2>/dev/null \
  | tail -n +$((KEEP_LOCAL + 1)) \
  | xargs -r rm -f --

echo "[${NAME}] done"
