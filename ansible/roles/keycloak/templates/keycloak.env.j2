KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/{{ keycloak_vault_db }}
KC_DB_USERNAME={{ keycloak_vault_db_user }}
KC_DB_PASSWORD={{ keycloak_vault_db_password }}
KC_HEALTH_ENABLED=true
KC_HOSTNAME=https://sso.{{ portfolio_domain_com }}
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=50 -XX:MaxMetaspaceSize=384m
KC_CACHE=local
KC_DB_POOL_INITIAL_SIZE=2
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_MAX_SIZE=20
