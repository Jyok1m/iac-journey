KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/{{ keycloak_vault_db }}
KC_DB_USERNAME={{ keycloak_vault_db_user }}
KC_DB_PASSWORD={{ keycloak_vault_db_password }}
KC_HEALTH_ENABLED=true
KC_HOSTNAME=https://sso.{{ portfolio_domain_com }}
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=50 -XX:MaxMetaspaceSize=384m
KC_CACHE=local

# Duree de vie des ressources statiques des themes, en secondes.
#
# Par defaut Keycloak les sert avec max-age=2592000, soit trente jours, et
# Cloudflare honore cet en-tete. Or l'URL de ces ressources porte un segment de
# version derive de la version de Keycloak, pas du contenu du theme : une
# modification du CSS garde la meme URL et reste invisible derriere le cache de
# l'edge jusqu'a expiration. Une heure laisse le benefice du cache sans faire
# d'un changement de theme une attente d'un mois.
KC_SPI_THEME_STATIC_MAX_AGE=3600
KC_DB_POOL_INITIAL_SIZE=2
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_MAX_SIZE=20
