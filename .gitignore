# Ansible secrets
**/files/*.env*
!**/files/.env.example
.vault_pass

# Terraform
*.tfstate
*.tfstate.*

# secrets
*.tfvars
!*.tfvars.example
!zones.auto.tfvars
# Mail DNS inputs: hostnames, addresses and report mailboxes only.
!mail.auto.tfvars
# Generated by the ansible mailcow role. The DKIM public key it carries is
# published in DNS by definition, so it is not a secret.
!mail.generated.auto.tfvars
backend.hcl
.envrc

# plans
tfplan
*.tfplan

# local
.terraform/
.terraformrc
terraform.rc
crash.log
*_override.tf
override.tf
override.tf.json
